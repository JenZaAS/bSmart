# Normalize text in Git for cross-platform agents/editors.
* text=auto eol=lf

# cmd.exe looks up goto labels unreliably in LF-only files. These polyglots
# stay CRLF in the working tree. The shell half ends each line with a comment
# so the carriage return is not glued onto the command.
integrations/cursor/bprotective-plugin/scripts/run_hook.cmd text eol=crlf
integrations/claude/bprotective-plugin/scripts/run_hook.cmd text eol=crlf

# Common binary assets/documents.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.tgz binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.ogg binary
