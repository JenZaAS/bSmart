#!/usr/bin/env python3
"""Initialize or explicitly reset bSmart startup hook files."""
from __future__ import annotations

import argparse
import os
from pathlib import Path

HOOK_NAMES = ("AGENTS.md", "HERMES.md", ".hermes.md", "CLAUDE.md", ".cursorrules")
CANONICAL_HOOKS = ("AGENTS.md", "HERMES.md")


def resolve_root(value: str | None) -> Path:
    if value:
        return Path(value).expanduser().resolve()
    if os.path.isdir("/.dockerenv") and Path("/workspace").is_dir():
        return Path("/workspace").resolve()
    return Path.cwd().resolve()


def load_template(root: Path) -> str:
    template = root / "bSmart-System" / "bSmart_Templates" / "AGENTS.md"
    if not template.is_file():
        raise SystemExit(f"ERROR: bSmart hook template not found: {template}")
    return template.read_text(encoding="utf-8")


def write_hook(path: Path, content: str) -> None:
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o664
    path.write_text(content, encoding="utf-8")
    path.chmod(mode)


def main() -> int:
    parser = argparse.ArgumentParser(description="Initialize or reset bSmart startup hooks")
    parser.add_argument("action", choices=("init", "reset", "check"))
    parser.add_argument("--root", help="Workspace root; defaults to /workspace in Docker or the current directory locally")
    args = parser.parse_args()

    root = resolve_root(args.root)
    content = load_template(root)
    existing = {name for name in HOOK_NAMES if (root / name).is_file()}

    if args.action == "init":
        targets = [name for name in CANONICAL_HOOKS if name not in existing]
        if not targets:
            print(f"bSmart hooks already initialized: {root}")
            return 0
    elif args.action == "reset":
        targets = [name for name in HOOK_NAMES if name in existing or name in CANONICAL_HOOKS]
    else:
        targets = [name for name in HOOK_NAMES if (root / name).is_file()]

    if args.action == "check":
        if not targets:
            print(f"bSmart hooks missing: {root}")
            return 1
        paths = [root / name for name in targets]
        identical = all(path.read_text(encoding="utf-8") == content for path in paths)
        print(f"bSmart hooks {'OK' if identical else 'NEED_RESET'}: {', '.join(path.name for path in paths)}")
        return 0 if identical else 1

    for name in targets:
        write_hook(root / name, content)
    print(f"bSmart hooks {args.action}: {', '.join(targets)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
