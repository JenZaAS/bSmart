#!/usr/bin/env python3
"""Run the shared bProtective CLI."""

from __future__ import annotations

import runpy
import sys
from pathlib import Path

CLI = Path(__file__).resolve().parents[1] / "integrations" / "bprotective" / "cli.py"

if __name__ == "__main__":
    sys.argv[0] = str(CLI)
    runpy.run_path(str(CLI), run_name="__main__")
