#!/usr/bin/env python3
"""Deterministically retrieve one bSmart feature description."""
from __future__ import annotations

import argparse
import re
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
SYSTEM_ROOT = SCRIPT_DIR.parent
FEATURES_FILE = SYSTEM_ROOT / "bSmart_Features.md"


def extract_feature(text: str, name: str) -> str | None:
    wanted = name.strip().lower()
    if not wanted:
        return None
    lines = text.splitlines()
    heading = re.compile(r"^###\s+(.+?)\s*$")
    for index, line in enumerate(lines):
        match = heading.match(line)
        if not match or match.group(1).strip().lower() != wanted:
            continue
        end = len(lines)
        for next_index in range(index + 1, len(lines)):
            if re.match(r"^##\s+", lines[next_index]) or re.match(r"^###\s+", lines[next_index]):
                end = next_index
                break
        return "\n".join(lines[index:end]).strip()
    # Permit the numbered compact list to be used before a detail card exists.
    for line in lines:
        if re.match(r"^\d+\.\s+", line) and wanted in line.split("—", 1)[0].lower():
            return line.strip()
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description="Retrieve one deterministic bSmart feature card.")
    parser.add_argument("feature", help="feature name, for example Projects or bSwarm")
    args = parser.parse_args()
    if not FEATURES_FILE.is_file():
        print(f"bFeature: feature registry not found: {FEATURES_FILE}")
        return 2
    entry = extract_feature(FEATURES_FILE.read_text(encoding="utf-8", errors="replace"), args.feature)
    if entry is None:
        print(f"bFeature: feature not found: {args.feature}")
        return 1
    print(f"registry: {FEATURES_FILE}")
    print(entry)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
