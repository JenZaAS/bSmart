#!/usr/bin/env python3
"""bTestTiers: tag manifest check, pass/fail history and automatic tier moves.

Rules: bSmart_Protocols/test-tiers.md. Reads run reports as JUnit XML (pytest,
vitest, jest, MATLAB, go, ...) or a small JSON list. History and settings live
in the instance: <content-root>/State/test-tiers/.

  bTestTiers init   --manifest M --report R...          add missing tests as ?/? (or their inline tag)
  bTestTiers check  --manifest M [--report R...]        tags valid, nothing untagged, high/fix not special
  bTestTiers place  --manifest M [--report R...]        one-time first tiers from the tags
  bTestTiers record --project P --repo N --report R... --tier normal|special|all --sha S --branch B [--manifest M]
                                                        with --manifest: also apply tier moves (and create a missing
                                                        manifest); always appends a log entry; checks setup and pause
  bTestTiers review --project P --repo N --manifest M [--apply] [--out FILE]
  bTestTiers due    --project P --repo N --sha S --branch B [--commit-date D]
                                                        exit 0 when a special run is due; reports "paused (inactive)"
  bTestTiers gate   --manifest M --report R...          exit 1 only for normal-tier failures (release / merge gate)
  bTestTiers issue  --project P --repo N [--manifest M] issue body for the last run's special-tier failures
  bTestTiers note   --project P --repo N --tier normal|special --text T   add a note (an issue link) to the last log entry

Exit codes: 0 ok (or due), 1 findings (or not due), 2 usage error.
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).absolute().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

import bsmart_test_tiers as tt
from bsmart_instance import default_content_root

SYSTEM_ROOT = SCRIPT_DIR.parent


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="bTestTiers", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp, manifest=False, store=False, report=False):
        if manifest:
            sp.add_argument("--manifest", default="test-tiers.txt", help="tag manifest in the code repo")
        if report:
            sp.add_argument("--report", action="append", default=[], help="JUnit XML or JSON run report")
        if store:
            sp.add_argument("--content-root", default=str(default_content_root(SYSTEM_ROOT)),
                            help="instance content root (default: the sibling bSmart folder)")
            sp.add_argument("--project", required=True)
            sp.add_argument("--repo", required=True)
        sp.add_argument("--slow-seconds", type=float, default=None)

    common(sub.add_parser("init"), manifest=True, report=True)
    common(sub.add_parser("check"), manifest=True, report=True)
    common(sub.add_parser("place"), manifest=True, report=True)
    r = sub.add_parser("record")
    common(r, store=True, report=True)
    r.add_argument("--tier", choices=["normal", "special", "all"], required=True)
    r.add_argument("--sha", required=True)
    r.add_argument("--branch", required=True)
    r.add_argument("--manifest", help="also apply the automatic tier moves to this manifest")
    g = sub.add_parser("gate")
    common(g, manifest=True, report=True)
    i = sub.add_parser("issue")
    common(i, store=True)
    i.add_argument("--manifest", help="tag manifest, to show tags and split a full run")
    o = sub.add_parser("note")
    common(o, store=True)
    o.add_argument("--tier", choices=["normal", "special"], required=True)
    o.add_argument("--text", required=True)
    v = sub.add_parser("review")
    common(v, manifest=True, store=True)
    v.add_argument("--apply", action="store_true", help="write the tier moves into the manifest")
    v.add_argument("--out", help="write the markdown report here")
    d = sub.add_parser("due")
    common(d, store=True)
    d.add_argument("--sha", required=True)
    d.add_argument("--branch", required=True)
    d.add_argument("--commit-date", help="date of the main commit (YYYY-MM-DD), for the inactivity pause")
    return p


def settings_for(args) -> dict:
    if hasattr(args, "project"):
        s = tt.load_settings(Path(args.content_root), args.project)
    else:
        s = dict(tt.DEFAULTS)
    if args.slow_seconds is not None:
        s["slow_seconds"] = args.slow_seconds
    return s


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return run(args)
    except (tt.UsageError, OSError, ValueError) as exc:
        print(f"bTestTiers: {exc}", file=sys.stderr)
        return 2


def run(args) -> int:
    settings = settings_for(args)
    reports = [Path(r) for r in getattr(args, "report", [])]
    results = tt.read_reports(reports) if reports else {}
    manifest = Path(args.manifest) if getattr(args, "manifest", None) else None
    entries, problems = tt.read_manifest(manifest) if manifest else ([], [])

    if args.cmd == "init":
        if not reports:
            raise tt.UsageError("init needs --report")
        added = 0
        for tid, r in sorted(results.items()):
            if tt.lookup(entries, tid) is None:
                _, tag, fix = tt.split_inline_tag(r.get("raw_name", ""))
                entries.append(tt.Entry("normal", tag or tt.UNTAGGED, fix, tid))
                added += 1
        tt.write_manifest(manifest, entries)
        print(f"init: {added} tests added, {len(entries)} lines in {manifest}")
        return 0

    if args.cmd == "gate":
        blocking, later = tt.gate(entries, results)
        for t in blocking:
            print(f"blocking (normal tier): {t}")
        for t in later:
            print(f"not blocking (special tier, open an issue for the next version): {t}")
        print(f"gate: {'blocked' if blocking else 'ok'}: {len(blocking)} blocking, {len(later)} special-tier failures")
        return 1 if blocking else 0

    if args.cmd == "check":
        if not manifest.is_file():
            print(f"check: no manifest at {manifest}")
            return 1
        findings = list(problems)
        seen = set()
        for e in entries:
            findings += tt.tag_problems(e)
            if e.pattern in seen:
                findings.append(f"duplicate: {e.pattern}")
            seen.add(e.pattern)
        notes = []
        for tid in sorted(results):
            if tt.lookup(entries, tid) is None:
                findings.append(f"not_in_manifest: {tid}")
        if results:
            notes = [f"stale (not in this report): {e.pattern}" for e in entries
                     if not e.is_glob and e.pattern not in results]
        for f in findings:
            print(f)
        for n in notes:
            print(n)
        print(f"check: {len(entries)} lines, {len(findings)} findings, {len(notes)} notes")
        return 1 if findings else 0

    if args.cmd == "place":
        tt.place(entries, results, settings)
        tt.write_manifest(manifest, entries)
        n = sum(e.tier == "special" for e in entries)
        print(f"place: {len(entries) - n} normal, {n} special lines in {manifest}")
        return 0

    folder = tt.store_dir(Path(args.content_root), args.project, args.repo)

    if args.cmd == "record":
        if not reports:
            raise tt.UsageError("record needs --report")
        created = 0
        if manifest is not None and not manifest.is_file():
            for tid, r in sorted(results.items()):
                _, tag, fix = tt.split_inline_tag(r.get("raw_name", ""))
                entries.append(tt.Entry("normal", tag or tt.UNTAGGED, fix, tid))
                created += 1
            tt.write_manifest(manifest, entries)
        run_ = tt.record_run(folder, results, args.tier, args.sha, args.branch, settings)
        if manifest is not None and created:
            run_["notes"].append(f"set up: manifest {manifest.name} created with {created} tests; tag them")
        moves = None
        if manifest is not None:
            moves = tt.review(entries, tt.load_history(folder), settings)
            if moves["to_normal"] or moves["to_special"]:
                tt.write_manifest(manifest, tt.apply_moves(entries, moves))
        log = tt.append_log(folder, run_, moves, settings)
        print(f"record: {run_['pass']} passed, {run_['fail']} failed, {run_['skip']} skipped, "
              f"{len(run_['new_failures'])} new failures -> {log}")
        for n in run_["notes"]:
            print(f"note: {n}")
        if tt.special_failures(run_, entries):
            print("special-tier failures: open an issue for the next version (bTestTiers issue), "
                  "then link it (bTestTiers note --tier special --text 'issue: <link>')")
        return 0

    if args.cmd == "issue":
        runs = folder / "runs.jsonl"
        rows = [tt.json.loads(x) for x in runs.read_text(encoding="utf-8").splitlines() if x.strip()] if runs.is_file() else []
        rows = [r for r in rows if tt.special_failures(r, entries)]
        if not rows:
            print("issue: no special-tier failures in the recorded runs")
            return 1
        print(tt.issue_body(rows[-1], entries, args.repo), end="")
        return 0

    if args.cmd == "note":
        print(f"note added to {tt.add_log_note(folder, args.tier, args.text)}")
        return 0

    if args.cmd == "due":
        due, why = tt.special_due(folder, args.sha, args.branch, settings, commit_date=args.commit_date)
        print(f"due: {'yes' if due else 'no'}: {why}")
        return 0 if due else 1

    if args.cmd == "review":
        hist = tt.load_history(folder)
        moves = tt.review(entries, hist, settings)
        if args.apply and (moves["to_normal"] or moves["to_special"]):
            tt.write_manifest(manifest, tt.apply_moves(entries, moves))
        text = tt.report_markdown(moves, args.apply)
        if args.out:
            tt.write_text_atomic(Path(args.out), text + "\n")
        print(text)
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
